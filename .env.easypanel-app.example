# EasyPanel App — variáveis (cole no Environment do serviço App)
#
# 1) Crie um Postgres no mesmo projeto EasyPanel
# 2) Cole a DATABASE_URL que o EasyPanel mostrar (host interno do postgres)
# 3) Preencha os segredos abaixo
# 4) CORS_ORIGIN = https://gestao.aguiaon.com

# ─── Obrigatórias ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aguia:SENHA@aguia_postgres:5432/aguia
JWT_SECRET=gere-com-openssl-rand-hex-32
ENCRYPTION_KEY=gere-com-openssl-rand-hex-32
SESSION_SECRET=gere-com-openssl-rand-hex-32
CORS_ORIGIN=https://gestao.aguiaon.com

ADMIN_BOOTSTRAP_EMAIL=admin@aguiaon.com
ADMIN_BOOTSTRAP_PASSWORD=SenhaForteMin10!

# ─── Recomendadas ─────────────────────────────────────────────────────────────
TOTP_ISSUER=AguiaAuto
ENABLE_INLINE_POLLERS=true
PROCESS_ROLE=api
API_PORT=3000
MULTI_TENANT_ENABLED=false
PROMETHEUS_ENABLED=false
OPENAPI_DOCS_ENABLED=true

# Redis (opcional — crie serviço Redis no EasyPanel e cole a URL)
# REDIS_URL=redis://aguia_redis:6379

# Gateway GPSWOX (opcional — app separado depois)
# GATEWAY_URL=
# GATEWAY_SECRET=
